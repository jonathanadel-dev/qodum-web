model User {
    id                Int      @id @default(autoincrement())
    name              String
    user_name         String   @unique
    password          String
    is_reset_password Boolean?
    designation       String?
    email             String?
    mobile            String?
    profile_picture   String?
    is_active         Boolean?
    enable_otp        Boolean?
    is_admin          Boolean?

    created_at        DateTime @default(now())
    updated_at        DateTime @updatedAt

    // Parents
    session       Int
    academic_year AcademicYear @relation(fields: [session], references: [id])
    schools    School[]
    // fee_types  FeeType[]
    // employee

    // Children
    permissions UserPermission[]
}