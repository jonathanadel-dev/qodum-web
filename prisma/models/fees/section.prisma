model Section {
  id            Int      @id @default(autoincrement())
  section_name  String
  order_no      Int
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // Parents
  session       Int
  academic_year AcademicYear @relation(fields: [session], references: [id])

  // Children
  classes Class[]


  // Relations
  @@unique([session, section_name])
}